# ---------- Frontend (public keys, safe in the browser) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=http://localhost:5173
# Optional error tracking (Sentry free plan)
VITE_SENTRY_DSN=

# ---------- Supabase Edge Function secrets ----------
# Set with:  npx supabase secrets set NAME=value
# NEVER put these in a VITE_ variable and never commit them.
#
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# AI_DAILY_LIMIT_PER_USER=40
# ALLOWED_ORIGINS=http://localhost:5173,https://YOUR-DOMAIN.com
